# Django Settings
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-key-q-molgen-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Default: SQLite for local embedded dev, or Supabase PostgreSQL)
DATABASE_URL=sqlite:///db.sqlite3

# Supabase Cloud Database & Auth Configuration
# 1. Sign up at https://supabase.com and create a project 'q-molgen'
# 2. Get your Project URL and Anon Public Key from Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase PostgreSQL Direct Connection URI (Project Settings > Database > Connection URI)
SUPABASE_DB_URI=postgresql://postgres.your-project-id:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Quantum Simulation Settings (Qiskit Aer)
DEFAULT_QUANTUM_BACKEND=aer_simulator
QUANTUM_SHOTS=1024

# Computation & Device Settings
DEVICE=cpu
RANDOM_SEED=42
